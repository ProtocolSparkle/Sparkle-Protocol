{
  "name": "@sparkleprotocol/core",
  "version": "1.0.2-dev.0",
  "description": "Bitcoin Ordinals swap primitives and Lightning integration interfaces; public mainnet evidence, unaudited",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "sparkle": "./dist/cli/sparkle-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:browser": "node scripts/build-browser.mjs",
    "build:all": "tsc && node scripts/build-browser.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:swap": "vitest run tests/swap.test.ts tests/core-regressions.test.ts",
    "test:e2e": "vitest run tests/swap-execution.test.ts",
    "test:verify": "vitest run tests/core-regressions.test.ts",
    "cli": "tsx src/cli/sparkle-cli.ts",
    "test:watch": "vitest",
    "example": "tsx examples/basic-swap.ts",
    "verify:proofs": "node scripts/verify-proof-artifacts.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run build:all && npm test && npm run example && npm run verify:proofs && npm run check:package"
  },
  "keywords": [
    "bitcoin",
    "ordinals",
    "inscriptions",
    "atomic-swap",
    "lightning-network",
    "taproot",
    "nostr",
    "cryptocurrency",
    "btc",
    "swap",
    "trustless"
  ],
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.3.3",
    "@scure/base": "^1.1.5",
    "@scure/btc-signer": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  },
  "author": "David A. Michael",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProtocolSparkle/Sparkle-Protocol"
  },
  "bugs": {
    "url": "https://github.com/ProtocolSparkle/Sparkle-Protocol/issues"
  },
  "homepage": "https://sparkleprotocol.com",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
